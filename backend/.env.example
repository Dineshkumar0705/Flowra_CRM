# ============================================================
# Flowra Backend — Environment Variables
# Copy to .env and fill in real values before running.
# Never commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Core
# ------------------------------------------------------------
ENV=development                          # development | staging | production
PROJECT_NAME=Flowra
VERSION=1.0.0
DEBUG=true

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://flowra:secret@localhost:5432/flowra_db
# For Docker Compose: postgresql+psycopg2://flowra:secret@postgres:5432/flowra_db

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
SECRET_KEY=change-me-to-a-64-char-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional: Fernet key for encrypting OAuth tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------
# SMTP / Email
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Flowra

# ------------------------------------------------------------
# WhatsApp Business Cloud API (Meta)
# ------------------------------------------------------------
WHATSAPP_TOKEN=                 # Meta Business access token
WHATSAPP_PHONE_NUMBER_ID=       # Phone Number ID from Meta dashboard
WHATSAPP_VERIFY_TOKEN=          # Custom token for webhook verification
WHATSAPP_APP_SECRET=            # App Secret for HMAC signature verification

# ------------------------------------------------------------
# Google / Gmail OAuth2
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback

# ------------------------------------------------------------
# Razorpay Billing
# ------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Slack (for Onboarding Autopilot)
# ------------------------------------------------------------
SLACK_BOT_TOKEN=                # xoxb-... bot token

# ------------------------------------------------------------
# Notion (for Onboarding Autopilot)
# ------------------------------------------------------------
NOTION_API_KEY=                 # secret_... integration token

# ------------------------------------------------------------
# Cloudflare R2 / S3 (file uploads)
# ------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=flowra-uploads
R2_PUBLIC_URL=

# ------------------------------------------------------------
# Redis (optional — for background jobs / caching)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# Feature flags
# ------------------------------------------------------------
ENABLE_ANALYTICS=true
ENABLE_AUTOMATION=true
